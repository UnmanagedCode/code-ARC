                      ],
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "changed_cells",
                    "bbox",
                    "changed_rows"
                  ],
                  "properties": {
                    "mode": {
                      "const": "diff"
                    },
                    "changed_cells": {
                      "type": "integer"
                    },
                    "bbox": {
