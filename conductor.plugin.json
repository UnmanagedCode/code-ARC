                              "type": "integer"
                            },
                            "x1": {
                              "type": "integer"
                            },
                            "y1": {
                              "type": "integer"
                            }
                          }
                        }
                      ]
                    },
                    "changed_rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "y",
                          "row"
                        ],
                        "properties": {
                          "y": {
                            "type": "integer"
                          },
                          "row": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "const": "none"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "const": "image"
                    },
                    "path": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "unavailable": {
                      "type": "string",
                      "enum": [
                        "no_frame",
                        "session_ended"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      {
        "name": "end_session",
        "description": "End a session and close its scorecard: the final state and scorecard summary. Always call this when done.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "pattern": "^s-[0-9a-f]{12}$"
            }
          },
          "required": [
            "session_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "game_id",
            "steps",
            "final"
          ],
          "properties": {
            "session_id": {
              "type": "string"
            },
            "game_id": {
              "type": "string"
            },
            "steps": {
              "type": "integer"
            },
            "final": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "levels_completed",
                "win_levels",
                "scorecard"
              ],
              "properties": {
                "state": {
                  "type": "string"
                },
                "levels_completed": {
                  "type": "number"
                },
                "win_levels": {
                  "type": "number"
                },
                "scorecard": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "card_id": {
                      "type": "string"
                    },
                    "score": {
                      "type": "number"
                    },
                    "total_levels_completed": {
                      "type": "number"
                    },
                    "total_levels": {
                      "type": "number"
                    },
                    "total_actions": {
                      "type": "number"
                    },
                    "environments": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "score": {
                            "type": "number"
                          },
                          "levels_completed": {
                            "type": "number"
                          },
                          "actions": {
                            "type": "number"
                          },
                          "resets": {
                            "type": "number"
                          },
                          "completed": {
                            "type": "boolean"
                          },
                          "level_count": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "scorecard_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "detail",
                  "note"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      {
        "name": "note",
        "description": "Open a script run on a session: a note saying what your run_code program tries next and why, shown live to the user above the steps it takes. Call it before a program's first act and again whenever its plan changes.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "pattern": "^s-[0-9a-f]{12}$"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "What the program tries and why, a sentence or two."
            }
          },
          "required": [
            "session_id",
            "note"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "run"
          ],
          "properties": {
            "session_id": {
              "type": "string"
            },
            "run": {
              "type": "integer",
              "description": "The run this note opened; json-format steps on the session record it until the next note."
            }
          }
        }
      },
      {
        "name": "list_sessions",
        "description": "List game sessions (newest first), e.g. to recover a session_id. scope 'mine' (default) is the ones you started. offset skips that many of the newest sessions, to page through a long list.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "mine",
                "all"
              ],
              "default": "mine"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "description": "Skip this many of the newest sessions, to page through a long list."
            }
          },
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "total",
            "sessions"
          ],
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "mine",
                "all"
              ]
            },
            "total": {
              "type": "integer",
              "description": "Sessions in scope (all of them, whatever offset was asked)."
            },
            "sessions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "session_id",
                  "game_id",
                  "title",
                  "mode",
                  "status",
                  "end_reason",
                  "stalled",
                  "step",
                  "owner",
                  "updated_at"
                ],
                "properties": {
                  "session_id": {
                    "type": "string"
                  },
                  "game_id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "local",
                      "online"
                    ]
                  },
                  "allow_reset": {
                    "const": false
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "live",
                      "ended"
                    ]
                  },
                  "end_reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "stalled": {
                    "type": "boolean"
                  },
                  "state": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "levels_completed": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "win_levels": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "step": {
                    "type": "integer"
                  },
                  "owner": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sessionId",
                      "project"
                    ],
                    "properties": {
                      "sessionId": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "project": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  },
                  "updated_at": {
                    "type": "string"
                  },
                  "scorecard_url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}
