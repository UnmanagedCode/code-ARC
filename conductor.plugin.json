                "type": "string"
              }
            },
            "step": {
              "type": "integer"
            },
            "frame_count": {
              "type": "number"
            },
            "full_reset": {
              "type": "boolean"
            },
            "online": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scorecard_url",
                "idle_close_at"
              ],
              "properties": {
                "scorecard_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "idle_close_at": {
                  "type": "string"
                }
              }
            },
            "frame": {
              "description": "The frame: hex row strings (one digit per cell, palette index 0-f; x = column, y = row, origin top-left).",
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
